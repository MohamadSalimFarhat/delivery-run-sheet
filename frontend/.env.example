# Copy this file to .env.local and fill in the values from your Supabase
# project: Settings -> API.
#
# Anything named VITE_* is bundled into the JavaScript and is PUBLIC.
# Never put a secret here. The Geoapify key is set in the Vercel dashboard
# without a VITE_ prefix, so it stays on the server.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Note there is no VITE_ prefix, which is exactly what keeps
# this out of the browser bundle. Set it in the Vercel dashboard; it is only
# needed locally if you run `vercel dev` to exercise frontend/api/map.ts.
GEOAPIFY_API_KEY=
