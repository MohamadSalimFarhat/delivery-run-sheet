# Copy this file to .env.local and fill in the values from your Supabase
# project: Settings -> API.
#
# Anything named VITE_* is bundled into the JavaScript and is PUBLIC.
# Never put a secret here. The Geoapify key is set in the Vercel dashboard
# without a VITE_ prefix, so it stays on the server.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
